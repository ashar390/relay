{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "relay-jobs"
      }
    ]
  }
}
