{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "relay-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "relay-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "relay-jobs-dead-letter"
      }
    ]
  }
}
